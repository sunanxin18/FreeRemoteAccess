  */
 
 #include "hevcdec.h"
+#include "config_components.h"
 
 #include "pred.h"
 
@@ -75,6 +76,10 @@
         break;
     }
 
+/* 私有 D1：Windows SEH/原生 ABI 门未闭合，不能作为组合 recipe 候选。 */
+#if ARCH_AARCH64 && HAVE_NEON_EXTERNAL && CONFIG_HEVC_DECODER && !defined(_WIN32)
+    ff_hevc_pred_init_aarch64(hpc, bit_depth);
+#endif
 #if ARCH_MIPS
     ff_hevc_pred_init_mips(hpc, bit_depth);
 #endif
