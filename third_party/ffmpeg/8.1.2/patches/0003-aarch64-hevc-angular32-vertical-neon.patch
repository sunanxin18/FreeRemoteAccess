diff --git a/libavcodec/hevc/pred.c b/libavcodec/hevc/pred.c
--- a/libavcodec/hevc/pred.c
+++ b/libavcodec/hevc/pred.c
@@ -40,6 +40,23 @@
 #define BIT_DEPTH 12
 #include "pred_template.c"
 #undef BIT_DEPTH
+
+/* 私有32候选：水平仍调用本 TU 的原 static C body，无可变全局后备。
+ * 只在现有非 Windows、exact8/NEON 初始化边界中选入 slot3。
+ */
+#if ARCH_AARCH64 && HAVE_NEON_EXTERNAL && CONFIG_HEVC_DECODER && !defined(_WIN32)
+void ff_hevc_pred_angular_32_v_8_neon(uint8_t *, const uint8_t *, const uint8_t *,
+                                    ptrdiff_t, int, int);
+void ff_hevc_pred_angular_32_8_dispatch_aarch64(uint8_t *dst, const uint8_t *top,
+                                               const uint8_t *left, ptrdiff_t stride,
+                                               int c_idx, int mode)
+{
+    if (mode >= 18)
+        ff_hevc_pred_angular_32_v_8_neon(dst, top, left, stride, c_idx, mode);
+    else
+        pred_angular_3_8(dst, top, left, stride, c_idx, mode);
+}
+#endif
 
 void ff_hevc_pred_init(HEVCPredContext *hpc, int bit_depth)
 {
