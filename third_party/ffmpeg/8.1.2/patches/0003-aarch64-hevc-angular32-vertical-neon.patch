 #if HAVE_NEON_EXTERNAL && CONFIG_HEVC_DECODER && !defined(_WIN32)
 void ff_hevc_pred_planar_16_8_neon(uint8_t *, const uint8_t *, const uint8_t *, ptrdiff_t);
 void ff_hevc_pred_angular_16_8_neon(uint8_t *, const uint8_t *, const uint8_t *, ptrdiff_t, int, int);
+void ff_hevc_pred_angular_32_8_dispatch_aarch64(uint8_t *, const uint8_t *, const uint8_t *, ptrdiff_t, int, int);
 #endif
 
 av_cold void ff_hevc_pred_init_aarch64(HEVCPredContext *hpc, int bit_depth)
@@ -22,6 +23,7 @@
     if (bit_depth == 8 && have_neon(av_get_cpu_flags())) {
         hpc->pred_planar[2]  = ff_hevc_pred_planar_16_8_neon;
         hpc->pred_angular[2] = ff_hevc_pred_angular_16_8_neon;
+        hpc->pred_angular[3] = ff_hevc_pred_angular_32_8_dispatch_aarch64;
     }
